# Ethereum On-Chain Intelligence: environment configuration.
# Copy to .env and adjust. Empty values fall back to the documented defaults.
# Never put private keys, seed phrases or paid API keys in this file's committed copy.

# ---------------------------------------------------------------------------
# Shared (indexer + API)
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#   docker compose: postgres://eoi:eoi@postgres:5432/eoi   (set automatically in compose)
#   local Postgres: postgres://eoi:eoi@localhost:5432/eoi
#   no Docker:      run `npm run db:local` and use postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_URL=postgres://eoi:eoi@localhost:5432/eoi

# JSON-RPC endpoint of an Ethereum node. A free public Sepolia endpoint works.
# If you use a provider URL that embeds an API key, keep it only in your local .env.
ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Chain id served by ETHEREUM_RPC_URL (11155111 = Sepolia). The indexer refuses to
# start if the RPC reports a different chain.
ETHEREUM_CHAIN_ID=11155111

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# RPC client behaviour.
RPC_TIMEOUT_MS=15000
RPC_MAX_RETRIES=5
# Client-side rate limit. Public endpoints throttle aggressively; stay under their limit.
RPC_MAX_REQUESTS_PER_SECOND=10

# ---------------------------------------------------------------------------
# Indexer
# ---------------------------------------------------------------------------

# Blocks must be this deep before they are indexed (reorg safety). See docs/adr/005.
CONFIRMATIONS=12

# Where to start when no checkpoint exists (ignored after the first run):
#   an absolute block (e.g. 11800000), a negative offset from the safe head (e.g. -500),
#   or "latest".
INDEXER_START_BLOCK=-500

# Blocks per atomic batch, parallel block fetches, and poll interval at chain head.
INDEXER_BATCH_SIZE=10
INDEXER_FETCH_CONCURRENCY=4
INDEXER_POLL_INTERVAL_MS=6000

# Deepest reorg the indexer repairs automatically; deeper ones stop it for an operator.
INDEXER_MAX_REORG_DEPTH=64

# Tokens whose metadata (name/symbol/decimals) is fetched per batch.
INDEXER_METADATA_BATCH_SIZE=20

# Interval for the periodic structured metrics log line.
INDEXER_METRICS_INTERVAL_MS=30000

# Port of the indexer's /health, /ready and /metrics endpoints.
INDEXER_HEALTH_PORT=4100

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=4000

# Comma-separated list of origins allowed by CORS (the web app's URL).
CORS_ORIGIN=http://localhost:3000

# Per-client rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# TTL for cached live RPC reads (balances, nonces).
CACHE_TTL_MS=15000

# Set to true only when the API runs behind a trusted reverse proxy, so the client IP
# from X-Forwarded-For is used for rate limiting. Otherwise clients could spoof it.
TRUST_PROXY=false

# Optional Ethereum MAINNET RPC, used only for ENS lookups. Leave empty to disable ENS.
ENS_RPC_URL=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------

# Public URL of the API as reached from the user's browser. Baked in at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
